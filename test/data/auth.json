  "passwordPolicy": {
    "tooShort": {
      "password": "abc",
      "expectedStatus": 422,
      "expectedErrorCode": "weak_password",
      "expectedError": "at least 6 characters"
    },
    "strong": {
      "passwordEnv": "FINORA_E2E_USER_PASSWORD"
    }
  },
  "anonymousWrite": {
    "expectedStatus": 401,
    "expectedCode": "42501",
    "expectedMessage": "row-level security policy"
  },
  "stateRow": {
    "version": 1,
    "note": "Marker written by the RLS-isolation case. The RLS policy scopes reads to auth.uid() = user_id, so user B must never see this row."
  },
  "C01_syncDisabled": {
    "expected": {
      "panelNotice": "Cloud sync is disabled in this build. Set BASE_URL and BASE_ANON_KEY in .env.local to enable it.",
      "signedOutBlurb": "Sync your data across devices with end-to-end RLS-scoped storage. Optional — Finora works fine without it. Your cloud copy is preserved when you sign out, so signing back in pulls the latest snapshot.",
      "signInButton": "Sign in",
      "dialogTabs": ["Sign in", "Create account"],
      "dialogHeadline": "Sign in to sync",
      "emailPlaceholder": "you@example.com",
      "forgotPassword": "Forgot password?"
    }
  },
  "C02_errors": {
    "invalidEmail": {
      "email": "not-an-email",
      "passwordEnv": "FINORA_E2E_USER_PASSWORD",
      "expectedError": "Enter a valid email address."
    },
    "wrongPassword": {
      "emailEnv": "FINORA_E2E_USER_EMAIL",
      "passwordEnv": "FINORA_E2E_USER_WRONG_PASSWORD",
      "expectedError": "That email and password don't match. Try again."
    },
    "existingEmail": {
      "emailEnv": "FINORA_E2E_USER_EMAIL",
      "password": "Pass@123",
      "expectedError": "An account with this email already exists. Try signing in instead."
    },
    "shortPassword": {
      "password": "short12",
      "expectedError": "Password doesn't meet the server's requirements."
    },
    "newEmail": {
      "emailEnv": "FINORA_E2E_NEW_USER_EMAIL",
      "password": "Pass@123",
      "expectedToast": "Account created",
      "expectedToastBody": "You're signed in and cloud sync is ready.",
      "alternativeToast": "Check your email"
    }
  },
  "C03_signedIn": {
    "expected": {
      "signedInAs": "Signed in as",
      "lastSyncedValues": ["never", "just now"],
      "buttons": ["Force sync now", "Change password", "Sign out"],
      "syncingLabel": "Syncing…",
      "syncToast": "Sync complete",
      "pillLabels": ["Cloud sync off", "Cloud off", "Synced", "Syncing…", "Offline", "Sync error"]
