# ─────────────────────────────────────────────────────────────────────
# Finora — environment variables
#
# Copy to `.env.local` (gitignored) and fill in. `.env.local` is read by
# Vite's `loadEnv(mode, root, '')` in `vite.config.ts`, which whitelists
# the two names below into `import.meta.env.*` for the client bundle.
#
# The names intentionally do NOT use the `VITE_` prefix — Vite would
# otherwise expose them under a name that implies "publicly readable".
# `src/lib/supabase.ts` reads them and exports `supabase === null` when
# either is missing, which is the "sync disabled" build.
#
# ⚠️ The Settings screen's on-screen hint names these variables
# correctly, but `src/components/SyncStatusPill.tsx` still names the
# old `VITE_SUPABASE_URL` / `VITE_SUPABASE_ANON_KEY` pair. Use the
# names below — they are the ones the app actually reads.
# ─────────────────────────────────────────────────────────────────────

# Supabase project URL. A local stack prints this from `supabase status`.
BASE_URL=

# Supabase anon (public) key. RLS-scoped — safe to ship in the bundle.
BASE_ANON_KEY=

# ─────────────────────────────────────────────────────────────────────
# E2E test credentials (Playwright)
#
# Consumed by `test/e2e/**` via `test/e2e/support/env.ts::requireEnv()`.
# The names are referenced from `test/data/auth.json`; the values never
# live in a tracked file.
#
# In CI, set these as repository secrets and export them into the
# environment before `npm run test:e2e`.
# ─────────────────────────────────────────────────────────────────────

# The password for the cloud-sync test account.
FINORA_E2E_USER_PASSWORD=

# A deliberately wrong password, used for the failed-sign-in cases.
FINORA_E2E_USER_WRONG_PASSWORD=

# The sign-in address of the cloud-sync test account. Defaults to the
# address in `test/data/auth.json` when unset.
FINORA_E2E_USER_EMAIL=

# A fresh address for the sign-up case. Must not already exist.
FINORA_E2E_NEW_USER_EMAIL=
