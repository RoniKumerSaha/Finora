# Finora — environment configuration
#
# Copy this file to `.env` and fill in the values you want to enable.
# Never commit `.env` (it's already in .gitignore).

# ── Cloud backup (Google Drive sync) ────────────────────────────────────
# V1.1 feature. Default: disabled. Flip to "true" to render the Cloud
# backup card inside Settings → Backup. Requires VITE_GOOGLE_CLIENT_ID
# below to be set, otherwise the Connect button will reject with an
# "unknown" error.
VITE_FEATURE_GDRIVE_SYNC=false

# OAuth 2.0 client id from Google Cloud Console. The app uses the GIS
# Token Model with the drive.file scope — no API key needed. Leave empty
# in production if VITE_FEATURE_GDRIVE_SYNC is false.
VITE_GOOGLE_CLIENT_ID=

# Release version (echoed in the Settings → About panel). CI replaces this
# at build time. Leave empty in dev so the panel falls back to package.json.
VITE_APP_VERSION=